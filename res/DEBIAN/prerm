#!/bin/bash

set -e

case $1 in
    remove|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		rm -f /usr/bin/neodesk

		if [ "systemd" == "${INITSYS}" ]; then

			systemctl stop neodesk || true
			systemctl disable neodesk || true
			rm -f /etc/systemd/system/neodesk.service /usr/lib/systemd/system/neodesk.service
		fi
        ;;
esac

exit 0
