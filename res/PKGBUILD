pkgname=neodesk
pkgver=1.5.0
pkgrel=0
epoch=
pkgdesc=""
arch=('x86_64' 'aarch64')
url="https://github.com/neodeskapp/neodesk-client"
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=('libdrm: DRM screen capture' 'libglvnd: DRM screen capture')
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  bundle="${HBB}/flutter/build/linux/x64/release/bundle"
	  [[ ${CARCH} == aarch64 ]] && bundle="${HBB}/flutter/build/linux/arm64/release/bundle"
	  mkdir -p "${pkgdir}/usr/share/neodesk" && cp -r "${bundle}"/* -t "${pkgdir}/usr/share/neodesk"
	  so=$(find "${DRMTAP_PREBUILT_DIR:-${HBB}/third_party/libdrmtap/build-pkg}" -maxdepth 1 -type f -name 'libdrmtap.so.0.*' 2>/dev/null || true)
	  if [[ -n "$so" ]]; then
	    install -Dm 755 "$so" -t "${pkgdir}/usr/lib/neodesk"
	    ln -s "$(basename "$so")" "${pkgdir}/usr/lib/neodesk/libdrmtap.so.0"
	    install -Dm 644 "$(dirname "$so")/../LICENSE" "${pkgdir}/usr/lib/neodesk/LICENSE.libdrmtap"
	  fi
  else
	  install -Dm 755 "${HBB}/target/release/rustdesk" "${pkgdir}/usr/share/neodesk/neodesk"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/neodesk/neodesk usr/bin/neodesk && popd
  install -Dm 644 $HBB/res/neodesk.service -t "${pkgdir}/usr/share/neodesk/files"
  install -Dm 644 $HBB/res/neodesk.desktop -t "${pkgdir}/usr/share/neodesk/files"
  install -Dm 644 $HBB/res/neodesk-link.desktop -t "${pkgdir}/usr/share/neodesk/files"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/neodesk.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/neodesk.svg"
}
