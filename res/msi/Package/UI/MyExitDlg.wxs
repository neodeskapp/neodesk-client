<!--
The finish page: says what setup did (set up, repaired or removed), whether
the client runs and where its icon is, and opens the client on Finish while
"Open" is ticked. The checkbox is only as wide as its box, with the label as
transparent text beside it: a checkbox control paints its own grey background
over the dialog bitmap.
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
        <!-- Ticked unless the command line says NDOPENAPP=0. -->
        <Property Id="NDOPENAPP" Value="1" />

        <!-- The finish page tells whether connections stay off, as the
             execute sequence decides from the same setting; NdConnectionsOff
             is private, so the execute sequence never sees it. -->
        <CustomAction Id="NdReadConnectionsOff.SetParam.PropertyName" Return="check" Property="PropertyName" Value="NdConnectionsOff" />
        <InstallUISequence>
            <Custom Action="SetPropertyServiceStop.SetParam.ConfigFile" After="CostFinalize" Condition="NOT Installed" />
            <Custom Action="SetPropertyServiceStop.SetParam.ConfigKey" After="SetPropertyServiceStop.SetParam.ConfigFile" Condition="NOT Installed" />
            <Custom Action="NdReadConnectionsOff.SetParam.PropertyName" After="SetPropertyServiceStop.SetParam.ConfigKey" Condition="NOT Installed" />
            <Custom Action="SetPropertyServiceStop" After="NdReadConnectionsOff.SetParam.PropertyName" Condition="NOT Installed" />
        </InstallUISequence>

        <UI>
            <Dialog Id="MyExitDialog" Width="370" Height="270" Title="!(loc.MyExitDialog_Title)">
                <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)">
                    <Publish Event="DoAction" Value="LaunchApp" Condition="NDOPENAPP = 1 AND NOT Installed" Order="1" />
                    <Publish Event="EndDialog" Value="Return" Order="999" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.ExitDialogBitmap)" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

                <Control Id="TitleInstalled" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.MyExitDlgTitleInstalled)" ShowCondition="NOT Installed" />
                <Control Id="TitleRemoved" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.MyExitDlgTitleRemoved)" ShowCondition="Installed AND REMOVE~=&quot;ALL&quot;" />
                <Control Id="TitleRepaired" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.MyExitDlgTitleRepaired)" ShowCondition="Installed AND NOT REMOVE~=&quot;ALL&quot;" />

                <Control Id="Running" Type="Text" X="135" Y="70" Width="220" Height="50" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.MyExitDlgRunning)" ShowCondition="NOT Installed AND NOT NdConnectionsOff=&quot;&apos;Y&apos;&quot; AND NOT CC_CONNECTION_TYPE=&quot;outgoing&quot;" />
                <Control Id="Ready" Type="Text" X="135" Y="70" Width="220" Height="50" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.MyExitDlgReady)" ShowCondition="NOT Installed AND (NdConnectionsOff=&quot;&apos;Y&apos;&quot; OR CC_CONNECTION_TYPE=&quot;outgoing&quot;)" />
                <Control Id="Removed" Type="Text" X="135" Y="70" Width="220" Height="50" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.MyExitDlgRemoved)" ShowCondition="Installed AND REMOVE~=&quot;ALL&quot;" />
                <Control Id="Repaired" Type="Text" X="135" Y="70" Width="220" Height="50" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.MyExitDlgRepaired)" ShowCondition="Installed AND NOT REMOVE~=&quot;ALL&quot;" />

                <Control Id="OpenCheckBox" Type="CheckBox" X="135" Y="130" Width="10" Height="10" Hidden="yes" Property="NDOPENAPP" CheckBoxValue="1" ShowCondition="NOT Installed" />
                <Control Id="OpenLabel" Type="Text" X="149" Y="130" Width="200" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.MyExitDlgOpen)" ShowCondition="NOT Installed" />
            </Dialog>

            <InstallUISequence>
                <Show Dialog="MyExitDialog" OnExit="success" />
            </InstallUISequence>
            <AdminUISequence>
                <Show Dialog="MyExitDialog" OnExit="success" />
            </AdminUISequence>
        </UI>
    </Fragment>
</Wix>
