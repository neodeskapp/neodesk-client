<!--
This file contains the declaration of all the localizable strings.
-->
<WixLocalization Culture="en-us" Codepage="1252"
	xmlns="http://wixtoolset.org/schemas/v4/wxl">

	<String Id="SummaryCodepage" Value="1252" />
	<String Id="ProductLanguage" Value="1033" />

	<!-- General strings -->
	<String Id="DowngradeError" Value="A newer version of [ProductName] is already installed." />

	<String Id="AR_Comment" Value="RustDesk" />

	<String Id="F_App" Value="RustDesk" />
	<String Id="F_App_Desc" Value="RustDesk - Main programs installations." />

	<String Id="SC_Uninstall" Value="Uninstall RustDesk" />
	<String Id="SC_Uninstall_Desc" Value="Removes RustDesk or parts of it from the computer" />

	<!-- Client related strings -->
	<String Id="F_Client" Value="Client" />
	<String Id="F_Client_Desc" Value="The user interface. Plays media files." />
	<String Id="F_LAVFilters" Value="LAV Filters" />
	<String Id="F_LAVFilters_Desc" Value="Recommended directshow filters for best audio and video playback experience." />

	<String Id="SC_Client" Value="RustDesk" />
	<String Id="SC_Client_Desc" Value="Start RustDesk." />

	<String Id="SC_Client_Tray" Value="RustDesk Tray" />
	<String Id="SC_Client_Tray_Desc" Value="Start RustDesk tray." />

	<!-- Server related strings -->
	<String Id="F_Server" Value="Server" />
	<String Id="F_Server_Desc" Value="The server part of RustDesk. Provides the MediaLibrary and other services." />

	<String Id="Service_DisplayName" Value="RustDesk Service" />
	<String Id="Service_Description" Value="This service runs the RustDesk Server." />

	<!-- Launch Conditions -->
	<String Id="LC_OS" Value="[ProductName] requires minimum Windows 7 / 2008 R2 as operating system." />
	<String Id="LC_ADMIN" Value="You need to be an administrator to install [ProductName]." />

	<!-- User Interfaces -->
	<String Id="AnotherAppDialogTitle" Value="{\WixUI_Font_Bigger}[ProductName] is already installed"/>
	<String Id="AnotherAppDialogDescription" Value="It was installed with the setup program (.exe), not with this package. Remove it in Settings under Apps first, then run this package again."/>

	<String Id="MyInstallDirDlgDesktopShortcuts" Value="Add a desktop shortcut" />
	<String Id="MyInstallDirDlgStartMenuShortcuts" Value="Add to the Start menu" />
	<String Id="MyInstallDirDlgPrinter" Value="Install the [ProductName] printer" />

	<!-- The wizard's own texts in the product's words (WixUI's strings are
	     overridable): plain sentences, sentence case, and the exe install
	     page's wording where both say the same. -->
	<String Id="WelcomeDlg_Title" Value="[ProductName] setup" />
	<String Id="WelcomeDlgTitle" Value="{\WixUI_Font_Bigger}Set up [ProductName]" />
	<String Id="WelcomeDlgDescription" Value="Setup installs the app and a service that starts with Windows, so people you allow can reach this computer.&#13;&#10;&#13;&#10;Click Next to continue." />
	<String Id="WelcomeUpdateDlgDescriptionUpdate" Value="Setup updates [ProductName] on this computer.&#13;&#10;&#13;&#10;Click Next to continue." />
	<String Id="PrepareDlg_Title" Value="[ProductName] setup" />
	<String Id="PrepareDlgTitle" Value="{\WixUI_Font_Bigger}Set up [ProductName]" />
	<String Id="PrepareDlgDescription" Value="Setup is getting ready." />
	<String Id="LicenseAgreementDlg_Title" Value="[ProductName] setup" />
	<String Id="LicenseAgreementDlgTitle" Value="{\WixUI_Font_Title}Licence" />
	<String Id="LicenseAgreementDlgDescription" Value="[ProductName] is free software under the AGPL-3.0." />
	<String Id="LicenseAgreementDlgLicenseAcceptedCheckBox" Value="I &amp;accept the licence" />
	<String Id="InstallDirDlg_Title" Value="[ProductName] setup" />
	<String Id="InstallDirDlgTitle" Value="{\WixUI_Font_Title}Where to install" />
	<String Id="InstallDirDlgDescription" Value="Keep this folder unless you need another one." />
	<String Id="InstallDirDlgFolderLabel" Value="Install [ProductName] in:" />
	<String Id="BrowseDlg_Title" Value="[ProductName] setup" />
	<String Id="VerifyReadyDlg_Title" Value="[ProductName] setup" />
	<String Id="VerifyReadyDlgInstallTitle" Value="{\WixUI_Font_Title}Ready to install" />
	<String Id="VerifyReadyDlgInstallText" Value="Click Install to set up [ProductName]. Windows asks for permission first." />
	<String Id="VerifyReadyDlgRepairTitle" Value="{\WixUI_Font_Title}Ready to repair" />
	<String Id="VerifyReadyDlgRepairText" Value="Click Repair to put back missing or damaged files of [ProductName]." />
	<String Id="VerifyReadyDlgRemoveTitle" Value="{\WixUI_Font_Title}Ready to remove" />
	<String Id="VerifyReadyDlgRemoveText" Value="Click Remove to remove [ProductName] and its service from this computer." />
	<String Id="VerifyReadyDlgUpdateTitle" Value="{\WixUI_Font_Title}Ready to update" />
