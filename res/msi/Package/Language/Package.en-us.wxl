	<String Id="ProgressDlgTextUpdating" Value="This takes about half a minute." />
	<String Id="ProgressDlgTitleChanging" Value="{\WixUI_Font_Title}Changing [ProductName]" />
	<String Id="ProgressDlgTextChanging" Value="This takes about half a minute." />
	<String Id="MaintenanceWelcomeDlg_Title" Value="[ProductName] setup" />
	<String Id="MaintenanceWelcomeDlgTitle" Value="{\WixUI_Font_Bigger}[ProductName] is installed" />
	<String Id="MaintenanceWelcomeDlgDescription" Value="Setup can repair it or remove it from this computer.&#13;&#10;&#13;&#10;Click Next to choose." />
	<String Id="MaintenanceTypeDlg_Title" Value="[ProductName] setup" />
	<String Id="MaintenanceTypeDlgTitle" Value="{\WixUI_Font_Title}Repair or remove" />
	<String Id="MaintenanceTypeDlgDescription" Value="Choose what setup does." />
	<String Id="MaintenanceTypeDlgChangeDisabledText" Value="[ProductName] has no parts to choose, so there is nothing to change." />
	<String Id="MaintenanceTypeDlgRepairText" Value="Puts back missing or damaged files, shortcuts and settings of [ProductName]." />
	<String Id="MaintenanceTypeDlgRemoveText" Value="Removes [ProductName] and its service from this computer." />
	<String Id="CancelDlg_Title" Value="[ProductName] setup" />
	<String Id="CancelDlgText" Value="Stop setting up [ProductName]?" />
	<String Id="UserExit_Title" Value="[ProductName] setup" />
	<String Id="UserExitTitle" Value="{\WixUI_Font_Bigger}Setup was cancelled" />
	<String Id="UserExitDescription1" Value="[ProductName] was not installed, and nothing on this computer was changed." />
