	<String Id="InvalidDirDlg_Title" Value="[ProductName] setup" />
	<String Id="ExitDialog_Title" Value="[ProductName] setup" />
	<String Id="MsiRMFilesInUse_Title" Value="[ProductName] setup" />
	<String Id="MsiRMFilesInUseTitle" Value="{\WixUI_Font_Title}[ProductName] is running" />
	<String Id="MsiRMFilesInUseDescription" Value="Setup needs to replace files these programs use." />
	<String Id="MsiRMFilesInUseText" Value="Setup can close them now and start them again when it is done. Otherwise Windows has to restart before the update is complete." />
	<String Id="MsiRMFilesInUseUseRM" Value="&amp;Close them and start them again" />
	<String Id="MsiRMFilesInUseDontUseRM" Value="&amp;Leave them running and restart Windows later" />
	<String Id="FilesInUse_Title" Value="[ProductName] setup" />
	<String Id="FilesInUseTitle" Value="{\WixUI_Font_Title}[ProductName] is running" />
	<String Id="FilesInUseDescription" Value="Setup needs to replace files these programs use." />
	<String Id="FilesInUseText" Value="Close these programs, then click Retry to go on, or Exit to stop setup." />

	<!-- The finish page (UI/MyExitDlg.wxs). -->
	<String Id="MyExitDialog_Title" Value="[ProductName] setup" />
	<String Id="MyExitDlgTitleInstalled" Value="{\WixUI_Font_Bigger}[ProductName] is set up" />
	<String Id="MyExitDlgTitleRemoved" Value="{\WixUI_Font_Bigger}[ProductName] is removed" />
	<String Id="MyExitDlgTitleRepaired" Value="{\WixUI_Font_Bigger}[ProductName] is repaired" />
	<String Id="MyExitDlgRunning" Value="[ProductName] is running. Its icon is on the taskbar next to the clock; if you don't see it there, click the arrow beside the icons." />
	<String Id="MyExitDlgReady" Value="[ProductName] is ready. Open it from the Start menu." />
	<String Id="MyExitDlgRemoved" Value="The app and its service are gone from this computer." />
	<String Id="MyExitDlgRepaired" Value="Missing or damaged files are back in place." />
	<String Id="MyExitDlgOpen" Value="Open [ProductName]" />

