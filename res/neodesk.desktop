[Desktop Entry]
Name=NeoDesk Client
GenericName=Remote Desktop
Comment=NeoDesk Remote Desktop
Exec=neodesk %u
Icon=neodesk
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
Keywords=internet;linux;dart;rust;remote-control;p2p;neodesk;remote-desktop;
Actions=new-window;
StartupWMClass=neodesk

X-Desktop-File-Install-Version=0.23

[Desktop Action new-window]
Name=Open a New Window
Exec=neodesk %u
